{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "format": {
      "type": "string",
      "const": "iface-bank@1"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "description": {
      "type": "string",
      "maxLength": 200
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "authors": {
      "default": [],
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 60
      }
    },
    "language": {
      "default": "zh-CN",
      "type": "string",
      "maxLength": 20
    },
    "tags": {
      "default": [],
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 20
      }
    },
    "homepage": {
      "type": "string",
      "format": "uri"
    },
    "modules": {
      "minItems": 1,
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20
          },
          "description": {
            "type": "string",
            "maxLength": 200
          },
          "icon": {
            "type": "string",
            "enum": [
              "atom",
              "bot",
              "braces",
              "brain",
              "chart-line",
              "coffee",
              "cog",
              "cpu",
              "database",
              "database-zap",
              "file-code",
              "folder-search",
              "gauge",
              "globe",
              "leaf",
              "library",
              "memory-stick",
              "message-square-text",
              "network",
              "palette",
              "pen-line",
              "server",
              "shield",
              "smartphone",
              "sparkles",
              "split",
              "terminal",
              "triangle",
              "workflow",
              "wrench"
            ]
          },
          "color": {
            "type": "string",
            "enum": [
              "blue",
              "violet",
              "pink",
              "rose",
              "orange",
              "amber",
              "green",
              "teal",
              "cyan"
            ]
          },
          "questions": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?!\\/)(?!.*(?:^|\\/)\\.\\.(?:\\/|$))[\\w.\\-/]+\\.(?:json|md)$"
              },
              {
                "maxItems": 3000,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
                    },
                    "difficulty": {
                      "anyOf": [
                        {
                          "type": "number",
                          "const": 1
                        },
                        {
                          "type": "number",
                          "const": 2
                        },
                        {
                          "type": "number",
                          "const": 3
                        }
                      ]
                    },
                    "question": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000
                    },
                    "answer": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 50000
                    },
                    "tags": {
                      "default": [],
                      "maxItems": 10,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 30
                      }
                    },
                    "source": {
                      "type": "string",
                      "maxLength": 30
                    },
                    "checks": {
                      "maxItems": 10,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
                          },
                          "kind": {
                            "type": "string",
                            "enum": [
                              "single",
                              "multiple"
                            ]
                          },
                          "prompt": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 2000
                          },
                          "options": {
                            "minItems": 2,
                            "maxItems": 8,
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "id": {
                                  "type": "string",
                                  "pattern": "^[a-z0-9]{1,8}$"
                                },
                                "text": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 500
                                }
                              },
                              "required": [
                                "id",
                                "text"
                              ]
                            }
                          },
                          "answerIds": {
                            "minItems": 1,
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "explanation": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 2000
                          },
                          "focus": {
                            "type": "string",
                            "maxLength": 60
                          }
                        },
                        "required": [
                          "id",
                          "kind",
                          "prompt",
                          "options",
                          "answerIds",
                          "explanation"
                        ]
                      }
                    }
                  },
                  "required": [
                    "id",
                    "difficulty",
                    "question",
                    "answer"
                  ]
                }
              }
            ]
          }
        },
        "required": [
          "id",
          "name",
          "questions"
        ]
      }
    }
  },
  "required": [
    "format",
    "name",
    "version",
    "license",
    "modules"
  ],
  "$id": "https://face.dogxi.me/schema/iface-bank-1.json",
  "title": "iFace question bank (iface-bank@1)",
  "description": "A question bank for iFace (https://face.dogxi.me). Spec: https://github.com/dogxii/iFace/blob/main/docs/bank-format.md"
}
